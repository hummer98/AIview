# SwiftFormat 0.61+ baseline. Start with deterministic, non-semantic rules that
# the current tree already satisfies; broaden only in format-only changes.
--swift-version 6.0
--indent 4
--linebreaks lf
--disable all
--enable duplicateImports,emptyBraces,linebreakAtEndOfFile,semicolons,spaceAroundBraces,spaceAroundGenerics,spaceInsideBraces
