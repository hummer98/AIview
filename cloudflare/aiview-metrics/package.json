{
  "name": "aiview-metrics",
  "private": true,
  "version": "2.0.0",
  "description": "AIview の匿名利用計測 Cloudflare Worker (D1)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "migrate:local": "wrangler d1 migrations apply aiview-metrics --local",
    "tail": "wrangler tail",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run deploy:dry-run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.21.0",
    "@cloudflare/workers-types": "5.20260811.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.120.1"
  }
}
